ANTHROPIC_API_KEY=
MONGODB_URI=
# LLM (OpenAI-compatible). Default Nebius gpt-oss-120b, falls back to LLM_FALLBACK_MODEL.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
BRIGHTDATA_API_TOKEN=
SEC_USER_AGENT="VentureSauce you@example.com"
# 1 = step through fixtures/job_acme.json instead of running the real pipeline
# 1 = replay the Acme fixture (no keys needed). Leave unset to use the real pipeline when LLM_API_KEY is set.
# VENTURESAUCE_FAKE=1
ANALYZE_PER_HOUR=20
# Vision (scanned PDFs, images)
VISION_MODEL=moonshotai/Kimi-K3
VISION_FALLBACK_MODEL=google/gemma-3-27b-it
# Fish Audio (spoken digest). Two voice model IDs = two-host podcast; one or none = single narrator.
FISH_API_KEY=
FISH_MODEL=s2.1-pro
FISH_VOICE_IDS=
# Speaking speed for the analyst and the digest (1.0 = Fish default; investors like ~1.2)
FISH_SPEED=1.2
